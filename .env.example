# Copy this file to .env.local and add values from your Supabase project.
# The homepage currently runs without these credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Server-only support email delivery (never prefix these with NEXT_PUBLIC_).
RESEND_API_KEY=re_your_resend_api_key
SUPPORT_RECIPIENT_EMAIL=your-private-inbox@example.com

# Set this to your canonical HTTPS domain before deploying.
# The local fallback is http://localhost:3000 for development only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
